---
title: ATLAS System Architecture
---
flowchart TB
    %% ── SEARCH RADAR CONTROLLER ──
    subgraph SR["SEARCH RADAR Controller"]
        direction TB
        SR1["SearchRadar\nFOV gate + track buffer"]
        SR2["BeamAlignment\nVisual FOV → bearing"]
        SR3["CueEmitter\nWorld-frame cue → ch1"]
        SR4["CueTelemetry\nPer-step logging"]
        SR5["geometry.py\naz / el / range helpers"]
        SR1 --> SR2 --> SR3
        SR3 --> SR4
        SR5 --> SR1
    end

    %% ── ATLAS CONTROLLER (SUPERVISOR) ──
    subgraph ATLAS["ATLAS CONTROLLER (Supervisor)"]
        direction TB

        FSM["AtlasFSM\nIDLE · AIM · TRACK_PREDICT · ENGAGING · RESET"]

        subgraph SENSE["SENSE LAYER"]
            direction LR
            A1["FireControlRadar\nFOV cone, real turret aim"]
            A2["SearchRadarLink\nReceives cue — ch1"]
            A3["AttackerGroundHitLink\nGround-hit pulse — ch2"]
            A4["BulletHitLink\nBullet-hit pulse — ch3"]
        end

        subgraph THINK["THINK LAYER"]
            direction LR
            T1["TrackFilter\nKalman 6-state\n[x y z vx vy vz]"]
            T2["BallisticPredictor\nClosed-form intercept"]
            T3["AttackPredictor\nSectorMap + SGDClassifier"]
        end

        subgraph ACT["ACT LAYER"]
            direction LR
            C1["Bullet\nRecycle lifecycle"]
            C2["Pan + Tilt motors\nRotationalMotor × 2"]
        end

        TEL["**TrackTelemetry**\nPer-step debug logging"]
        LIB["**lib/ (shared)**\ngeometry.py · scene.py"]

        FSM --> SENSE
        SENSE --> THINK
        THINK --> ACT
        THINK --> TEL
        LIB --> SENSE
        LIB --> THINK
    end

    %% ── ATTACKER CONTROLLER ──
    subgraph ATK["ATTACKER CONTROLLER"]
        direction TB
        K1["Projectile\nSpawn / despawn lifecycle"]
        K2["AttackPattern\nStructured noisy drift"]
        K3["Sectors\nLaunch geometry"]
        K4["on_ground_hit\nEmits ch2 pulse"]
        K5["on_bullet_hit\nEmits ch3 pulse"]
        K1 --> K4
        K1 --> K5
        K2 --> K3 --> K1
    end

    %% ── WEBOTS PHYSICS ──
    WB["Webots Physics Layer\nODE, gravity, contacts"]

    %% ── RADIO LINKS ──
    SR3 -- "ch1 cue\n(SR → ATLAS)" --> A2
    K4 -- "ch2 hit pulse\n(Attacker → ATLAS)" --> A3
    K5 -- "ch3 hit pulse\n(Attacker → ATLAS)" --> A4
    WB -. physics .-> ATK
    WB -. physics .-> ATLAS

    %% ── STYLES ──
    classDef srStyle    fill:#829cbd,stroke:#0b1829,color:#0b1829
    classDef atlasStyle fill:#6581a3,stroke:#22354d,color:#22354d
    classDef atkStyle   fill:#712B13,stroke:#F0997B,color:#F5C4B3
    classDef thinkStyle fill:#86c1fc,stroke:#051f38,color:#051f38
    classDef wbStyle    fill:#080629,stroke:#e0dff0,color:#e0dff0

    class SR,SR1,SR2,SR3,SR4,SR5 srStyle
    class ATLAS,FSM,A1,A2,A3,A4,C1,C2,TEL,LIB atlasStyle
    class ATK,K1,K2,K3,K4,K5 atkStyle
    class T1,T2,T3 thinkStyle
    class WB wbStyle