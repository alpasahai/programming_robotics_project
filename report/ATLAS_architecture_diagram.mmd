    %% ══════════════════════════════════════════
    classDef srStyle    fill:#1a4a6b,stroke:#5bafd6,color:#cce8f5,rx:8
    classDef atlasStyle fill:#2d3a6b,stroke:#7b8fe0,color:#d0d8f8
    classDef senseStyle fill:#1b3d5c,stroke:#4fa3cc,color:#b8ddf0
    classDef thinkStyle fill:#163356,stroke:#4a90d9,color:#a8d0f0
    classDef actStyle   fill:#1a2e50,stroke:#6a9fd8,color:#bdd6f0
    classDef atkStyle   fill:#5a1a0d,stroke:#e07050,color:#f5c4b3
    classDef wbStyle    fill:#1a1a2e,stroke:#8080c0,color:#c0c0e8
    classDef fsmStyle   fill:#3a2d6b,stroke:#a090e0,color:#e0d8fc
    classDef libStyle   fill:#1f3350,stroke:#608ab0,color:#b0cce0

    class SR,SR1,SR2,SR3,SR4,SR5 srStyle
    class ATLAS,SENSE,THINK,ACT atlasStyle
    class A1,A2,A3,A4 senseStyle
    class T1,T2,T3 thinkStyle
    class C1,C2 actStyle
    class ATK,K1,K2,K3,K4,K5 atkStyle
    class WB wbStyle
    class FSM fsmStyle
    class TEL,LIB libStyle